{
    "name": "setono/sylius-facebook-plugin",
    "description": "Sylius plugin that tracks visitors and sends the data to Facebook",
    "license": "MIT",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "setono",
        "facebook",
        "meta",
        "server side tracking"
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "doctrine/collections": "^1.6",
        "fakerphp/faker": "^1.19",
        "knplabs/knp-menu": "^3.3",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "setono/meta-conversions-api-bundle": "^0.1",
        "setono/meta-conversions-api-php-sdk": "^0.2",
        "sylius/channel": "^1.0",
        "sylius/channel-bundle": "^1.0",
        "sylius/core": "^1.0",
        "sylius/core-bundle": "^1.0",
        "sylius/locale": "^1.0",
        "sylius/order": "^1.0",
        "sylius/product": "^1.0",
        "sylius/resource-bundle": "^1.6",
        "sylius/taxonomy": "^1.0",
        "sylius/ui-bundle": "^1.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/event-dispatcher": "^5.4 || ^6.4 || ^7.0",
        "symfony/form": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/options-resolver": "^5.4 || ^6.4 || ^7.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "api-platform/core": "^2.7",
        "babdev/pagerfanta-bundle": "^3.8",
        "behat/behat": "^3.14",
        "doctrine/doctrine-bundle": "^2.11",
        "infection/infection": "^0.27.11",
        "jms/serializer-bundle": "^4.2",
        "kriswallsmith/buzz": "^1.2",
        "lexik/jwt-authentication-bundle": "^2.16",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^9.6",
        "psalm/plugin-phpunit": "^0.18",
        "psalm/plugin-symfony": "^5.0",
        "setono/code-quality-pack": "^2.9",
        "setono/tag-bag": "^2.3",
        "setono/tag-bag-bundle": "^3.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "sylius/sylius": "~1.12.19",
        "symfony/debug-bundle": "^5.4 || ^6.4 || ^7.0",
        "symfony/dotenv": "^5.4 || ^6.4 || ^7.0",
        "symfony/intl": "^5.4 || ^6.4 || ^7.0",
        "symfony/property-info": "^5.4 || ^6.4 || ^7.0",
        "symfony/serializer": "^5.4 || ^6.4 || ^7.0",
        "symfony/web-profiler-bundle": "^5.4 || ^6.4 || ^7.0",
        "symfony/webpack-encore-bundle": "^1.14",
        "willdurand/negotiation": "^3.1"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\SyliusFacebookPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\SyliusFacebookPlugin\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "symfony/thanks": false
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "psalm",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit"
    }
}
